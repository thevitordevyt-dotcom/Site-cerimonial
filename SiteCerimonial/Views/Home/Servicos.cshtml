@{
    ViewData["Title"] = "Nossos Serviços";
}

<!-- Banner Imagem -->
<section class="relative h-[320px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200');">
    <div class="absolute bottom-6 left-8 md:left-24">
        <a href="#" class="bg-[#176282] text-white font-medium px-6 py-3 shadow hover:bg-[#114b64] transition inline-block text-sm">
            Solicitar orçamento
        </a>
    </div>
</section>

<!-- Descrição do Serviço -->
<section class="py-10 px-8 max-w-5xl mx-auto">
    <div class="flex items-center justify-center gap-4 mb-6">
        <span class="text-pink-400 text-2xl">🌹</span>
        <h2 class="text-2xl font-black text-black font-brand uppercase tracking-wider">NOSSOS SERVIÇOS</h2>
        <span class="text-pink-400 text-2xl">🌹</span>
    </div>

    <div class="bg-[#ccbe14] rounded-2xl p-8 text-center text-white font-brand">
        <h3 class="text-2xl font-bold text-[#00aeef] mb-4 tracking-wide uppercase">CERIMÔNIA CIVIL</h3>
        <p class="text-sm md:text-base font-bold leading-relaxed max-w-3xl mx-auto uppercase">
            NA ELANCE CERIMONIAL, TRANSFORMAMOS MOMENTOS ÚNICOS EM MEMÓRIAS INESQUECÍVEIS. 
            NOSSO TRABALHO VAI MUITO ALÉM DA CONDUÇÃO DE UMA CERIMÔNIA: CUIDAMOS DE CADA DETALHE 
            PARA QUE SUA CELEBRAÇÃO REFLITA, DE FORMA AUTÊNTICA, A HISTÓRIA E A ESSÊNCIA DE QUEM VOCÊ É.
        </p>
    </div>
</section>