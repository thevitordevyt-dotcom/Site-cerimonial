@{
    ViewData["Title"] = "Sobre Nós";
}

<section class="py-8 px-8 max-w-7xl mx-auto">
    <!-- Grid Superior (Foto + Texto Em destaque) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 items-stretch rounded-lg overflow-hidden">
        <div>
            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800" alt="Cerimonialista" class="w-full h-full object-cover min-h-[300px]" />
        </div>
        <div class="bg-[#ccbe14] p-8 flex items-center justify-center">
            <p class="text-white font-brand font-bold text-sm md:text-base leading-relaxed uppercase">
                A ELANCE CERIMONIAL NASCEU DA PAIXÃO POR TRANSFORMAR CERIMÔNIAS EM MOMENTOS ÚNICOS E INESQUECÍVEIS. 
                COM SENSIBILIDADE, PROFISSIONALISMO E ATENÇÃO A CADA DETALHE, CONDUZIMOS SEU GRANDE DIA COM A EMOÇÃO E A ELEGÂNCIA QUE ELE MERECE.
            </p>
        </div>
    </div>

    <!-- Galeria / Equipe -->
    <div class="mt-12">
        <h2 class="text-xl font-black text-black font-brand uppercase tracking-wider mb-6">SOBRE</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 1" class="w-full h-48 object-cover shadow" />
            <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 2" class="w-full h-48 object-cover shadow" />
        </div>
    </div>
</section>