@{
    ViewData["Title"] = "Depoimentos";
}

<!-- Banner principal -->
<section class="h-[300px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=1200');">
</section>

<!-- Lista de Depoimentos -->
<section class="py-10 px-8 max-w-6xl mx-auto text-center">
    <h2 class="text-xl font-black text-black font-brand uppercase tracking-wider mb-10">DEPOIMENTOS</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Depoimento 1 -->
        <div class="flex flex-col items-center">
            <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-[#a29415] mb-4 shadow">
                <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=300" alt="Vicente e Patricia" class="w-full h-full object-cover" />
            </div>
            <h3 class="font-serif font-bold text-gray-800 text-sm">Vicente e patricia</h3>
            <p class="text-xs text-gray-600 mt-1 font-serif italic">Equipe excelente, muito atenciosos e profissionais</p>
        </div>

        <!-- Depoimento 2 -->
        <div class="flex flex-col items-center">
            <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-[#a29415] mb-4 shadow">
                <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=300" alt="Rosana e Bernardo" class="w-full h-full object-cover" />
            </div>
            <h3 class="font-serif font-bold text-gray-800 text-sm">Rosana e bernado</h3>
            <p class="text-xs text-gray-600 mt-1 font-serif italic">Equipe excelente, muito atenciosos e profissionais</p>
        </div>

        <!-- Depoimento 3 -->
        <div class="flex flex-col items-center">
            <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-[#a29415] mb-4 shadow">
                <img src="https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?q=80&w=300" alt="Renata e Luis" class="w-full h-full object-cover" />
            </div>
            <h3 class="font-serif font-bold text-gray-800 text-sm">Renata e luis</h3>
            <p class="text-xs text-gray-600 mt-1 font-serif italic">Equipe excelente, muito atenciosos e profissionais</p>
        </div>
    </div>
</section>