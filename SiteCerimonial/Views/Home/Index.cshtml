@{
    Layout = null; // Caso esteja usando um _Layout.cshtml padrão do MVC, pode remover esta linha.
}

<!DOCTYPE html>
<html lang="pt-br" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enlace Cerimoniais</title>
    
    <!-- Checagem prévia do tema salvo no localStorage -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        // 1. Ouro Champagne
                        champagne: {
                            DEFAULT: '#C5A059',
                            hover: '#A88440',
                            light: '#EADBB8'
                        },
                        // 2. Rosa Quartzo / Dusty Rose
                        dustyrose: {
                            DEFAULT: '#C87582',
                            hover: '#A95865',
                            light: '#F4DCDD'
                        },
                        // 3. Verde Eucalipto
                        eucalyptus: {
                            DEFAULT: '#5A7B68',
                            hover: '#435E4F',
                            light: '#CBE0D4'
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        .font-brand { font-family: 'Fredoka', cursive, sans-serif; }
        .font-body { font-family: 'Inter', sans-serif; }
        .modal-active { overflow: hidden; }
    </style>
</head>
<body class="bg-stone-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-body antialiased transition-colors duration-300 selection:bg-champagne selection:text-white">

    <!-- HEADER / NAVBAR -->
    <header class="bg-white dark:bg-gray-900 border-b border-stone-200 dark:border-gray-800 py-4 px-8 sticky top-0 z-40 shadow-sm transition-colors duration-300">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- Logo -->
            <a href="#inicio" class="text-2xl font-black tracking-wider text-gray-900 dark:text-white font-brand hover:opacity-80 transition">
                ENLACE
            </a>
            
            <!-- Links do Menu -->
            <nav class="hidden md:flex gap-8 items-center">
                <a href="#sobre" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    SOBRE
                </a>
                <a href="#servicos" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    SERVIÇOS
                </a>
                <a href="#depoimentos" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    DEPOIMENTOS
                </a>
            </nav>

            <!-- Ações: Botão Dark Mode + Área do Cliente -->
            <div class="flex items-center gap-3">
                <!-- Botão Alternar Dark/Light -->
                <button onclick="toggleDarkMode()" id="btnTheme" title="Alternar Modo Claro/Escuro" class="p-2 rounded-lg bg-stone-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-stone-200 dark:hover:bg-gray-700 transition">
                    <span id="themeIcon">🌙</span>
                </button>

                <button onclick="openModal('modalLogin')" class="text-eucalyptus dark:text-eucalyptus-light font-brand font-bold text-sm px-4 py-2 rounded border border-eucalyptus dark:border-eucalyptus-light hover:bg-eucalyptus hover:text-white dark:hover:bg-eucalyptus-light dark:hover:text-gray-900 transition">
                    ENTRAR
                </button>
                <button onclick="openModal('modalCadastro')" class="bg-dustyrose text-white font-brand font-bold text-sm px-4 py-2 rounded hover:bg-dustyrose-hover transition shadow-sm">
                    CADASTRAR CASAL
                </button>
            </div>
        </div>
    </header>

    <!-- 1. HERO / INÍCIO COM FOTO DO CASAMENTO -->
    <section id="inicio" class="bg-eucalyptus dark:bg-eucalyptus-hover text-white py-16 px-8 relative overflow-hidden min-h-[460px] flex items-center transition-colors duration-300">
        <div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 items-center gap-10">
            <div>
                <h1 class="text-4xl md:text-5xl font-bold text-champagne-light drop-shadow-sm font-body leading-tight">
                    Cerimônias<br />
                    que contam<br />
                    sua história
                </h1>
                <p class="mt-4 text-stone-100 text-sm md:text-base max-w-md font-normal leading-relaxed">
                    Condução de cerimônias de casamento com acolhimento, elegância e atenção a cada detalhe.
                </p>
                <div class="mt-8">
                    <button onclick="openModal('modalOrcamento')" class="bg-champagne text-white font-medium px-6 py-3 shadow-lg hover:bg-champagne-hover transition inline-block text-sm cursor-pointer rounded">
                        Solicitar orçamento
                    </button>
                </div>
            </div>
            
            <!-- FOTO SELECIONADA + ANÉIS DECORATIVOS DA PALETA -->
            <div class="relative flex justify-center md:justify-end items-center">
                <!-- Anéis decorativos de fundo (Champagne + Dusty Rose) -->
                <div class="absolute -top-4 -right-4 w-32 h-32 hidden sm:flex items-center justify-center opacity-90 pointer-events-none z-0">
                    <div class="absolute w-20 h-20 border-[6px] border-champagne rounded-full left-0"></div>
                    <div class="absolute w-20 h-20 border-[6px] border-dustyrose rounded-full right-0"></div>
                </div>

                <!-- Foto do Casamento -->
                <div class="relative z-10 w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20 transform md:rotate-1 hover:rotate-0 transition duration-300">
                    <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=800" 
                        alt="Cerimônia de Casamento" 
                    class="w-full h-72 md:h-80 object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. RESUMO DOS SERVIÇOS (CARDS) -->
    <section class="py-12 px-8 max-w-7xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white mb-8 font-brand uppercase tracking-wider">NOSSOS SERVIÇOS</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-dustyrose rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-dustyrose dark:text-dustyrose-light font-brand tracking-wide">CERIMÔNIA CIVIL</h3>
                    <p class="text-xs font-bold text-eucalyptus dark:text-eucalyptus-light uppercase mt-2 font-brand">ROTEIRO PERSONALIZADO PARA O CASAL</p>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-champagne rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-champagne dark:text-champagne-light font-brand tracking-wide">MESTRE DE CERIMÔNIA</h3>
                    <p class="text-xs font-bold text-dustyrose dark:text-dustyrose-light uppercase mt-2 font-brand">CONDUÇÃO COMPLETA DO GRANDE DIA</p>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-eucalyptus rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-eucalyptus dark:text-eucalyptus-light font-brand tracking-wide">ASSESSORIA DE ROTEIRO</h3>
                    <p class="text-xs font-bold text-champagne dark:text-champagne-light uppercase mt-2 font-brand">CRIAÇÃO DE ROTEIRO COMPLETO PARA O GRANDE DIA</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. DETALHAMENTO DE SERVIÇOS -->
    <section id="servicos" class="scroll-mt-16">
        <!-- Banner de Imagem -->
        <div class="relative h-[320px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200');">
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute bottom-6 left-8 md:left-24 z-10">
                <button onclick="openModal('modalOrcamento')" class="bg-champagne text-white font-medium px-6 py-3 shadow hover:bg-champagne-hover transition inline-block text-sm cursor-pointer rounded">
                    Solicitar orçamento
                </button>
            </div>
        </div>

        <!-- Bloco de Descrição Principal -->
        <div class="py-12 px-8 max-w-5xl mx-auto">
            <div class="flex items-center justify-center gap-4 mb-6">
                <span class="text-dustyrose text-2xl">🌹</span>
                <h2 class="text-2xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider">NOSSOS SERVIÇOS</h2>
                <span class="text-dustyrose text-2xl">🌹</span>
            </div>

            <div class="bg-eucalyptus dark:bg-eucalyptus-hover rounded-2xl p-8 text-center text-white font-brand shadow-md transition-colors duration-300">
                <h3 class="text-2xl font-bold text-champagne-light mb-4 tracking-wide uppercase">CERIMÔNIA CIVIL</h3>
                <p class="text-sm md:text-base font-bold leading-relaxed max-w-3xl mx-auto uppercase">
                    NA ENLACE CERIMONIAL, TRANSFORMAMOS MOMENTOS ÚNICOS EM MEMÓRIAS INESQUECÍVEIS. 
                    NOSSO TRABALHO VAI MUITO ALÉM DA CONDUÇÃO DE UMA CERIMÔNIA: CUIDAMOS DE CADA DETALHE 
                    PARA QUE SUA CELEBRAÇÃO REFLITA, DE FORMA AUTÊNTICA, A HISTÓRIA E A ESSÊNCIA DE QUEM VOCÊ É.
                </p>
            </div>
        </div>
    </section>

    <!-- 4. SOBRE NÓS -->
    <section id="sobre" class="py-12 px-8 max-w-7xl mx-auto scroll-mt-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-0 items-stretch rounded-lg overflow-hidden shadow-sm">
            <div>
                <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800" alt="Cerimonialista" class="w-full h-full object-cover min-h-[300px]" />
            </div>
            <div class="bg-dustyrose dark:bg-dustyrose-hover p-8 flex items-center justify-center transition-colors duration-300">
                <p class="text-white font-brand font-bold text-sm md:text-base leading-relaxed uppercase">
                    A ENLACE CERIMONIAL NASCEU DA PAIXÃO POR TRANSFORMAR CERIMÔNIAS EM MOMENTOS ÚNICOS E INESQUECÍVEIS. 
                    COM SENSIBILIDADE, PROFISSIONALISMO E ATENÇÃO A CADA DETALHE, CONDUZIMOS SEU GRANDE DIA COM A EMOÇÃO E A ELEGÂNCIA QUE ELE MERECE.
                </p>
            </div>
        </div>

        <div class="mt-12">
            <h2 class="text-xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider mb-6">SOBRE</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 1" class="w-full h-48 object-cover shadow rounded-sm" />
                <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 2" class="w-full h-48 object-cover shadow rounded-sm" />
            </div>
        </div>
    </section>

    <!-- 5. DEPOIMENTOS -->
    <section id="depoimentos" class="scroll-mt-16">
        <div class="h-[300px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=1200');"></div>

        <div class="py-12 px-8 max-w-6xl mx-auto text-center">
            <h2 class="text-xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider mb-10">DEPOIMENTOS</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=300" alt="Vicente e Patricia" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Vicente e patricia</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>

                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=300" alt="Rosana e Bernardo" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Rosana e bernado</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>

                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?q=80&w=300" alt="Renata e Luis" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Renata e luis</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-stone-100 dark:bg-gray-950 border-t border-stone-200 dark:border-gray-800 py-6 text-center text-xs text-gray-500 dark:text-gray-400 font-body transition-colors duration-300">
        &copy; @DateTime.Now.Year Enlace Cerimoniais. Todos os direitos reservados.
    </footer>


    <!-- ========================================== -->
    <!-- MODAIS / FORMULÁRIOS INTERATIVOS -->
    <!-- ========================================== -->

    <!-- MODAL 1: CADASTRO DE CASAL -->
    <div id="modalCadastro" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-lg w-full p-8 relative shadow-2xl overflow-y-auto max-h-[90vh]">
            <button onclick="closeModal('modalCadastro')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-dustyrose dark:text-dustyrose-light font-brand mb-1">Cadastro do Casal</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Crie sua conta para acompanhar o roteiro e orçamentos do seu grande dia.</p>

            <form method="post" asp-action="Cadastrar" onsubmit="finalizarCadastro(event)">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Nome do Cônjuge 1</label>
                        <input type="text" required placeholder="Ex: Ana Silva" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Nome do Cônjuge 2</label>
                        <input type="text" required placeholder="Ex: Pedro Santos" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail Principal</label>
                    <input type="email" id="cadEmail" required placeholder="casal@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">WhatsApp / Telefone</label>
                        <input type="tel" required placeholder="(11) 99999-9999" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Data do Casamento</label>
                        <input type="date" required class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Crie uma Senha</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                </div>

                <button type="submit" class="w-full bg-dustyrose text-white font-brand font-bold py-3 rounded-lg hover:bg-dustyrose-hover transition shadow-md uppercase">
                    Finalizar Cadastro
                </button>

                <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
                    Já possui conta? <a href="#" onclick="trocarModal('modalCadastro', 'modalLogin')" class="text-dustyrose dark:text-dustyrose-light font-bold hover:underline">Fazer Login</a>
                </p>
            </form>
        </div>
    </div>

    <!-- MODAL 2: LOGIN DO CASAL -->
    <div id="modalLogin" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-md w-full p-8 relative shadow-2xl">
            <button onclick="closeModal('modalLogin')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-eucalyptus dark:text-eucalyptus-light font-brand mb-1">Entrar na Conta</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Acesse para gerenciar os detalhes da sua cerimônia.</p>

            <!-- Alerta pós-cadastro -->
            <div id="mensagemSucessoCadastro" class="hidden bg-green-50 dark:bg-green-900/40 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800 text-xs p-3 rounded-lg mb-4">
                Cadastro realizado com sucesso! Faça seu login abaixo.
            </div>

            <form method="post" asp-action="Login" onsubmit="fazerLogin(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail</label>
                    <input type="email" id="loginEmail" required placeholder="casal@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-eucalyptus" />
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Senha</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-eucalyptus" />
                </div>

                <button type="submit" class="w-full bg-eucalyptus text-white font-brand font-bold py-3 rounded-lg hover:bg-eucalyptus-hover transition shadow-md uppercase">
                    Entrar
                </button>

                <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
                    Ainda não tem conta? <a href="#" onclick="trocarModal('modalLogin', 'modalCadastro')" class="text-eucalyptus dark:text-eucalyptus-light font-bold hover:underline">Cadastrar o Casal</a>
                </p>
            </form>
        </div>
    </div>

    <!-- MODAL 3: SOLICITAR ORÇAMENTO -->
    <div id="modalOrcamento" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-lg w-full p-8 relative shadow-2xl overflow-y-auto max-h-[90vh]">
            <button onclick="closeModal('modalOrcamento')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-champagne dark:text-champagne-light font-brand mb-1">Solicitar Orçamento</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Preencha os campos abaixo e entraremos em contato rapidamente.</p>

            <form method="post" asp-action="SolicitarOrcamento" onsubmit="enviarOrcamento(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Nome do Casal / Responsável</label>
                    <input type="text" required placeholder="Ex: Ana e Pedro" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail</label>
                        <input type="email" required placeholder="contato@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">WhatsApp</label>
                        <input type="tel" required placeholder="(11) 99999-9999" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Serviço Desejado</label>
                    <select class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne">
                        <option>Cerimônia Civil</option>
                        <option>Mestre de Cerimônia</option>
                        <option>Assessoria de Roteiro</option>
                        <option>Pacote Completo</option>
                    </select>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Mensagem ou Detalhes da Cerimônia</label>
                    <textarea rows="3" placeholder="Conte-nos um pouco sobre como imaginam esse momento..." class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne"></textarea>
                </div>

                <button type="submit" class="w-full bg-champagne text-white font-brand font-bold py-3 rounded-lg hover:bg-champagne-hover transition shadow-md uppercase">
                    Enviar Solicitação
                </button>
            </form>
        </div>
    </div>


    <!-- ========================================== -->
    <!-- JAVASCRIPT DE INTERATIVIDADE -->
    <!-- ========================================== -->
    <script>
        // Atualiza ícone do botão de Tema ao carregar
        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains('dark');
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.textContent = isDark ? '☀️' : '🌙';
            }
        }

        // Alterna entre Modo Dark e Light
        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeIcon();
        }

        // Controle dos Modais
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.body.classList.add('modal-active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.body.classList.remove('modal-active');
        }

        function trocarModal(modalAtual, modalDestino) {
            closeModal(modalAtual);
            openModal(modalDestino);
        }

        // Fluxo: Cadastro -> Login
        function finalizarCadastro(event) {
            event.preventDefault();
            const emailCadastrado = document.getElementById('cadEmail').value;
            document.getElementById('loginEmail').value = emailCadastrado;
            document.getElementById('mensagemSucessoCadastro').classList.remove('hidden');
            trocarModal('modalCadastro', 'modalLogin');
        }

        function fazerLogin(event) {
            event.preventDefault();
            alert('Login efetuado com sucesso!');
            closeModal('modalLogin');
        }

        function enviarOrcamento(event) {
            event.preventDefault();
            alert('Sua solicitação de orçamento foi enviada com sucesso! Entraremos em contato em breve.');
            closeModal('modalOrcamento');
        }

        // Inicializa o ícone do tema correto ao abrir a página
        document.addEventListener('DOMContentLoaded', updateThemeIcon);
    </script>
</body>
</html>