@{
    Layout = null; // Caso esteja usando um _Layout.cshtml padrão do MVC, pode remover esta linha.
}

<!DOCTYPE html>
<html lang="pt-br" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enlace Cerimoniais - Painel & Site</title>
    
    <!-- Checagem prévia do tema salvo no localStorage -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        // 1. Ouro Champagne
                        champagne: {
                            DEFAULT: '#C5A059',
                            hover: '#A88440',
                            light: '#EADBB8'
                        },
                        // 2. Rosa Quartzo / Dusty Rose
                        dustyrose: {
                            DEFAULT: '#C87582',
                            hover: '#A95865',
                            light: '#F4DCDD'
                        },
                        // 3. Verde Eucalipto
                        eucalyptus: {
                            DEFAULT: '#5A7B68',
                            hover: '#435E4F',
                            light: '#CBE0D4'
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        .font-brand { font-family: 'Fredoka', cursive, sans-serif; }
        .font-body { font-family: 'Inter', sans-serif; }
        .modal-active { overflow: hidden; }
    </style>
</head>
<body class="bg-stone-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-body antialiased transition-colors duration-300 selection:bg-champagne selection:text-white">

    <!-- HEADER / NAVBAR -->
    <header class="bg-white dark:bg-gray-900 border-b border-stone-200 dark:border-gray-800 py-4 px-8 sticky top-0 z-40 shadow-sm transition-colors duration-300">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- Logo -->
            <a href="#inicio" class="text-2xl font-black tracking-wider text-gray-900 dark:text-white font-brand hover:opacity-80 transition">
                ENLACE
            </a>
            
            <!-- Links do Menu -->
            <nav class="hidden md:flex gap-8 items-center">
                <a href="#sobre" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    SOBRE
                </a>
                <a href="#servicos" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    SERVIÇOS
                </a>
                <a href="#depoimentos" class="text-eucalyptus dark:text-eucalyptus-light font-bold tracking-wide font-brand hover:text-champagne transition">
                    DEPOIMENTOS
                </a>
            </nav>

            <!-- Ações: Dark Mode + Botões Cliente + Botão Admin -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Botão Dark Mode -->
                <button onclick="toggleDarkMode()" id="btnTheme" title="Alternar Modo Claro/Escuro" class="p-2 rounded-lg bg-stone-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-stone-200 dark:hover:bg-gray-700 transition">
                    <span id="themeIcon">🌙</span>
                </button>

                <!-- Botão Login de Usuário -->
                <button onclick="openModal('modalLogin')" class="text-eucalyptus dark:text-eucalyptus-light font-brand font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded border border-eucalyptus dark:border-eucalyptus-light hover:bg-eucalyptus hover:text-white dark:hover:bg-eucalyptus-light dark:hover:text-gray-900 transition">
                    ENTRAR
                </button>

                <!-- Botão Cadastrar Casal -->
                <button onclick="openModal('modalCadastro')" class="bg-dustyrose text-white font-brand font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded hover:bg-dustyrose-hover transition shadow-sm">
                    CADASTRAR CASAL
                </button>

                <!-- Botão Acesso Admin -->
                <button onclick="openModal('modalAdminLogin')" class="bg-stone-800 dark:bg-stone-700 text-champagne-light font-brand font-bold text-xs px-3 py-2 rounded hover:bg-stone-900 transition shadow-sm flex items-center gap-1" title="Área Restrita do Gestor">
                    <span>🔐</span> <span class="hidden lg:inline">ADMIN</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 1. HERO / INÍCIO COM FOTO DO CASAMENTO -->
    <section id="inicio" class="bg-eucalyptus dark:bg-eucalyptus-hover text-white py-16 px-8 relative overflow-hidden min-h-[460px] flex items-center transition-colors duration-300">
        <div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 items-center gap-10">
            <div>
                <h1 class="text-4xl md:text-5xl font-bold text-champagne-light drop-shadow-sm font-body leading-tight">
                    Cerimônias<br />
                    que contam<br />
                    sua história
                </h1>
                <p class="mt-4 text-stone-100 text-sm md:text-base max-w-md font-normal leading-relaxed">
                    Condução de cerimônias de casamento com acolhimento, elegância e atenção a cada detalhe.
                </p>
                <div class="mt-8">
                    <button onclick="openModal('modalOrcamento')" class="bg-champagne text-white font-medium px-6 py-3 shadow-lg hover:bg-champagne-hover transition inline-block text-sm cursor-pointer rounded">
                        Solicitar orçamento
                    </button>
                </div>
            </div>
            
            <!-- FOTO SELECIONADA + ANÉIS DECORATIVOS DA PALETA -->
            <div class="relative flex justify-center md:justify-end items-center">
                <div class="absolute -top-4 -right-4 w-32 h-32 hidden sm:flex items-center justify-center opacity-90 pointer-events-none z-0">
                    <div class="absolute w-20 h-20 border-[6px] border-champagne rounded-full left-0"></div>
                    <div class="absolute w-20 h-20 border-[6px] border-dustyrose rounded-full right-0"></div>
                </div>

                <div class="relative z-10 w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20 transform md:rotate-1 hover:rotate-0 transition duration-300">
                    <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=800" 
                         alt="Cerimônia de Casamento" 
                         class="w-full h-72 md:h-80 object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. RESUMO DOS SERVIÇOS (CARDS) -->
    <section class="py-12 px-8 max-w-7xl mx-auto">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white mb-8 font-brand uppercase tracking-wider">NOSSOS SERVIÇOS</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-dustyrose rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-dustyrose dark:text-dustyrose-light font-brand tracking-wide">CERIMÔNIA CIVIL</h3>
                    <p class="text-xs font-bold text-eucalyptus dark:text-eucalyptus-light uppercase mt-2 font-brand">ROTEIRO PERSONALIZADO PARA O CASAL</p>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-champagne rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-champagne dark:text-champagne-light font-brand tracking-wide">MESTRE DE CERIMÔNIA</h3>
                    <p class="text-xs font-bold text-dustyrose dark:text-dustyrose-light uppercase mt-2 font-brand">CONDUÇÃO COMPLETA DO GRANDE DIA</p>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-stone-200/70 dark:bg-gray-800 rounded-2xl p-6 relative min-h-[200px] flex flex-col justify-between transition-colors duration-300">
                <div class="w-8 h-8 bg-eucalyptus rounded-full"></div>
                <div>
                    <h3 class="text-xl font-bold text-eucalyptus dark:text-eucalyptus-light font-brand tracking-wide">ASSESSORIA DE ROTEIRO</h3>
                    <p class="text-xs font-bold text-champagne dark:text-champagne-light uppercase mt-2 font-brand">CRIAÇÃO DE ROTEIRO COMPLETO PARA O GRANDE DIA</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. DETALHAMENTO DE SERVIÇOS -->
    <section id="servicos" class="scroll-mt-16">
        <div class="relative h-[320px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200');">
            <div class="absolute inset-0 bg-black/30"></div>
            <div class="absolute bottom-6 left-8 md:left-24 z-10">
                <button onclick="openModal('modalOrcamento')" class="bg-champagne text-white font-medium px-6 py-3 shadow hover:bg-champagne-hover transition inline-block text-sm cursor-pointer rounded">
                    Solicitar orçamento
                </button>
            </div>
        </div>

        <div class="py-12 px-8 max-w-5xl mx-auto">
            <div class="flex items-center justify-center gap-4 mb-6">
                <span class="text-dustyrose text-2xl">🌹</span>
                <h2 class="text-2xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider">NOSSOS SERVIÇOS</h2>
                <span class="text-dustyrose text-2xl">🌹</span>
            </div>

            <div class="bg-eucalyptus dark:bg-eucalyptus-hover rounded-2xl p-8 text-center text-white font-brand shadow-md transition-colors duration-300">
                <h3 class="text-2xl font-bold text-champagne-light mb-4 tracking-wide uppercase">CERIMÔNIA CIVIL</h3>
                <p class="text-sm md:text-base font-bold leading-relaxed max-w-3xl mx-auto uppercase">
                    NA ENLACE CERIMONIAL, TRANSFORMAMOS MOMENTOS ÚNICOS EM MEMÓRIAS INESQUECÍVEIS. 
                    NOSSO TRABALHO VAI MUITO ALÉM DA CONDUÇÃO DE UMA CERIMÔNIA: CUIDAMOS DE CADA DETALHE 
                    PARA QUE SUA CELEBRAÇÃO REFLITA, DE FORMA AUTÊNTICA, A HISTÓRIA E A ESSÊNCIA DE QUEM VOCÊ É.
                </p>
            </div>
        </div>
    </section>

    <!-- 4. SOBRE NÓS -->
    <section id="sobre" class="py-12 px-8 max-w-7xl mx-auto scroll-mt-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-0 items-stretch rounded-lg overflow-hidden shadow-sm">
            <div>
                <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800" alt="Cerimonialista" class="w-full h-full object-cover min-h-[300px]" />
            </div>
            <div class="bg-dustyrose dark:bg-dustyrose-hover p-8 flex items-center justify-center transition-colors duration-300">
                <p class="text-white font-brand font-bold text-sm md:text-base leading-relaxed uppercase">
                    A ENLACE CERIMONIAL NASCEU DA PAIXÃO POR TRANSFORMAR CERIMÔNIAS EM MOMENTOS ÚNICOS E INESQUECÍVEIS. 
                    COM SENSIBILIDADE, PROFISSIONALISMO E ATENÇÃO A CADA DETALHE, CONDUZIMOS SEU GRANDE DIA COM A EMOÇÃO E A ELEGÂNCIA QUE ELE MERECE.
                </p>
            </div>
        </div>

        <div class="mt-12">
            <h2 class="text-xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider mb-6">SOBRE</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 1" class="w-full h-48 object-cover shadow rounded-sm" />
                <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=600" alt="Equipe de Cerimonial 2" class="w-full h-48 object-cover shadow rounded-sm" />
            </div>
        </div>
    </section>

    <!-- 5. DEPOIMENTOS -->
    <section id="depoimentos" class="scroll-mt-16">
        <div class="h-[300px] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=1200');"></div>

        <div class="py-12 px-8 max-w-6xl mx-auto text-center">
            <h2 class="text-xl font-black text-gray-900 dark:text-white font-brand uppercase tracking-wider mb-10">DEPOIMENTOS</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=300" alt="Vicente e Patricia" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Vicente e patricia</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>

                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=300" alt="Rosana e Bernardo" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Rosana e bernado</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>

                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-champagne mb-4 shadow">
                        <img src="https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?q=80&w=300" alt="Renata e Luis" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="font-serif font-bold text-gray-800 dark:text-gray-200 text-sm">Renata e luis</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-serif italic max-w-xs">Equipe excelente, muito atenciosos e profissionais</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-stone-100 dark:bg-gray-950 border-t border-stone-200 dark:border-gray-800 py-6 text-center text-xs text-gray-500 dark:text-gray-400 font-body transition-colors duration-300">
        <p>&copy; @DateTime.Now.Year Enlace Cerimoniais. Todos os direitos reservados.</p>
        <button onclick="openModal('modalAdminLogin')" class="mt-2 text-stone-400 hover:text-champagne transition underline">
            Acesso Restrito - Área do Gestor
        </button>
    </footer>


    <!-- ========================================== -->
    <!-- MODAIS E PAINÉIS INTERATIVOS -->
    <!-- ========================================== -->

    <!-- MODAL 1: CADASTRO DE CASAL (PÚBLICO) -->
    <div id="modalCadastro" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-lg w-full p-8 relative shadow-2xl overflow-y-auto max-h-[90vh]">
            <button onclick="closeModal('modalCadastro')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-dustyrose dark:text-dustyrose-light font-brand mb-1">Cadastro do Casal</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Crie sua conta para acompanhar o roteiro e orçamentos do seu grande dia.</p>

            <form onsubmit="finalizarCadastro(event)">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Cônjuge 1</label>
                        <input type="text" id="cadConjuge1" required placeholder="Ex: Ana Silva" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Cônjuge 2</label>
                        <input type="text" id="cadConjuge2" required placeholder="Ex: Pedro Santos" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail Principal</label>
                    <input type="email" id="cadEmail" required placeholder="casal@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">WhatsApp</label>
                        <input type="tel" id="cadTelefone" required placeholder="(11) 99999-9999" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Data do Casamento</label>
                        <input type="date" id="cadData" required class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Crie uma Senha</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-dustyrose" />
                </div>

                <button type="submit" class="w-full bg-dustyrose text-white font-brand font-bold py-3 rounded-lg hover:bg-dustyrose-hover transition shadow-md uppercase">
                    Finalizar Cadastro
                </button>

                <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
                    Já possui conta? <a href="#" onclick="trocarModal('modalCadastro', 'modalLogin')" class="text-dustyrose dark:text-dustyrose-light font-bold hover:underline">Fazer Login</a>
                </p>
            </form>
        </div>
    </div>

    <!-- MODAL 2: LOGIN DO CASAL (PÚBLICO) -->
    <div id="modalLogin" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-md w-full p-8 relative shadow-2xl">
            <button onclick="closeModal('modalLogin')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-eucalyptus dark:text-eucalyptus-light font-brand mb-1">Entrar na Conta</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Acesse para gerenciar os detalhes da sua cerimônia.</p>

            <div id="mensagemSucessoCadastro" class="hidden bg-green-50 dark:bg-green-900/40 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800 text-xs p-3 rounded-lg mb-4">
                Cadastro realizado com sucesso! Faça seu login abaixo.
            </div>

            <form onsubmit="fazerLogin(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail</label>
                    <input type="email" id="loginEmail" required placeholder="casal@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-eucalyptus" />
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Senha</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-eucalyptus" />
                </div>

                <button type="submit" class="w-full bg-eucalyptus text-white font-brand font-bold py-3 rounded-lg hover:bg-eucalyptus-hover transition shadow-md uppercase">
                    Entrar
                </button>

                <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
                    Ainda não tem conta? <a href="#" onclick="trocarModal('modalLogin', 'modalCadastro')" class="text-eucalyptus dark:text-eucalyptus-light font-bold hover:underline">Cadastrar o Casal</a>
                </p>
            </form>
        </div>
    </div>

    <!-- MODAL 3: SOLICITAR ORÇAMENTO (PÚBLICO) -->
    <div id="modalOrcamento" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl max-w-lg w-full p-8 relative shadow-2xl overflow-y-auto max-h-[90vh]">
            <button onclick="closeModal('modalOrcamento')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-bold text-champagne dark:text-champagne-light font-brand mb-1">Solicitar Orçamento</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Preencha os campos abaixo e entraremos em contato rapidamente.</p>

            <form onsubmit="enviarOrcamento(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Nome do Casal / Responsável</label>
                    <input type="text" id="orcNome" required placeholder="Ex: Ana e Pedro" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">E-mail</label>
                        <input type="email" id="orcEmail" required placeholder="contato@email.com" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">WhatsApp</label>
                        <input type="tel" id="orcTelefone" required placeholder="(11) 99999-9999" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Serviço Desejado</label>
                    <select id="orcServico" class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne">
                        <option>Cerimônia Civil</option>
                        <option>Mestre de Cerimônia</option>
                        <option>Assessoria de Roteiro</option>
                        <option>Pacote Completo</option>
                    </select>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Mensagem ou Detalhes da Cerimônia</label>
                    <textarea id="orcMensagem" rows="3" placeholder="Conte-nos um pouco sobre como imaginam esse momento..." class="w-full px-3 py-2 border border-stone-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg text-sm focus:outline-none focus:border-champagne"></textarea>
                </div>

                <button type="submit" class="w-full bg-champagne text-white font-brand font-bold py-3 rounded-lg hover:bg-champagne-hover transition shadow-md uppercase">
                    Enviar Solicitação
                </button>
            </form>
        </div>
    </div>


    <!-- ========================================== -->
    <!-- 🔑 ÁREA RESTRITA: LOGIN DO ADMINISTRADOR -->
    <!-- ========================================== -->
    <div id="modalAdminLogin" class="fixed inset-0 bg-black/75 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-stone-900 text-white rounded-2xl max-w-md w-full p-8 relative shadow-2xl border border-champagne/30">
            <button onclick="closeModal('modalAdminLogin')" class="absolute top-4 right-4 text-stone-400 hover:text-white text-2xl font-bold">&times;</button>
            
            <div class="flex items-center gap-2 mb-2">
                <span class="text-2xl">🔐</span>
                <h2 class="text-2xl font-bold text-champagne font-brand">Acesso Gestor</h2>
            </div>
            <p class="text-xs text-stone-400 mb-6">Painel exclusivo para cerimonialistas e administradores.</p>

            <div id="erroAdmin" class="hidden bg-red-900/50 text-red-200 border border-red-700 text-xs p-3 rounded-lg mb-4">
                E-mail ou senha inválidos. Tente novamente!
            </div>

            <form onsubmit="fazerLoginAdmin(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-stone-300 uppercase mb-1">E-mail do Administrador</label>
                    <input type="email" id="adminEmail" required value="admin@enlace.com" class="w-full px-3 py-2 bg-stone-800 border border-stone-700 text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold text-stone-300 uppercase mb-1">Senha</label>
                    <input type="password" id="adminSenha" required value="admin123" class="w-full px-3 py-2 bg-stone-800 border border-stone-700 text-white rounded-lg text-sm focus:outline-none focus:border-champagne" />
                </div>

                <div class="bg-stone-800/80 p-3 rounded-lg border border-stone-700 text-[11px] text-stone-400 mb-6">
                    💡 <strong>Credenciais de Demonstração:</strong><br />
                    E-mail: <span class="text-champagne-light">admin@enlace.com</span> | Senha: <span class="text-champagne-light">admin123</span>
                </div>

                <button type="submit" class="w-full bg-champagne hover:bg-champagne-hover text-white font-brand font-bold py-3 rounded-lg transition shadow-md uppercase tracking-wider">
                    Acessar Painel
                </button>
            </form>
        </div>
    </div>


    <!-- ========================================== -->
    <!-- 📊 PAINEL ADMINISTRATIVO (DASHBOARD) -->
    <!-- ========================================== -->
    <div id="adminDashboard" class="fixed inset-0 bg-stone-900/95 z-50 hidden overflow-y-auto p-4 md:p-8">
        <div class="max-w-7xl mx-auto bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl shadow-2xl border border-stone-200 dark:border-gray-700 overflow-hidden my-4">
            
            <!-- Header do Painel Admin -->
            <div class="bg-stone-900 text-white p-6 border-b border-champagne/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">👑</span>
                        <h1 class="text-2xl font-bold font-brand text-champagne">Painel Administrativo - Enlace</h1>
                    </div>
                    <p class="text-xs text-stone-400 mt-1">Gestão de orçamentos, casais cadastrados e acessos ao sistema em tempo real.</p>
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-xs bg-eucalyptus/30 text-eucalyptus-light border border-eucalyptus/50 px-3 py-1 rounded-full font-mono">
                        Online: admin@enlace.com
                    </span>
                    <button onclick="sairAdmin()" class="bg-red-600/80 hover:bg-red-600 text-white font-brand text-xs font-bold px-4 py-2 rounded transition">
                        SAIR
                    </button>
                </div>
            </div>

            <!-- KPIs / Resumo Geral -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-6 bg-stone-100 dark:bg-gray-900 border-b border-stone-200 dark:border-gray-700">
                <div class="bg-white dark:bg-gray-800 p-4 rounded-xl border-l-4 border-dustyrose shadow-sm">
                    <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Casais Cadastrados</p>
                    <p class="text-2xl font-black font-brand text-dustyrose dark:text-dustyrose-light mt-1" id="statCadastros">0</p>
                </div>
                <div class="bg-white dark:bg-gray-800 p-4 rounded-xl border-l-4 border-champagne shadow-sm">
                    <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Solicitações de Orçamento</p>
                    <p class="text-2xl font-black font-brand text-champagne dark:text-champagne-light mt-1" id="statOrcamentos">0</p>
                </div>
                <div class="bg-white dark:bg-gray-800 p-4 rounded-xl border-l-4 border-eucalyptus shadow-sm">
                    <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Acessos / Logins</p>
                    <p class="text-2xl font-black font-brand text-eucalyptus dark:text-eucalyptus-light mt-1" id="statLogins">0</p>
                </div>
            </div>

            <!-- Navegação por Abas -->
            <div class="flex border-b border-stone-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-800 px-6 gap-4 font-brand text-sm">
                <button onclick="mudarAbaAdmin('abaOrcamentos')" id="tabOrcamentos" class="py-3 px-4 font-bold border-b-2 border-champagne text-champagne">
                    💰 SOLICITAÇÕES DE ORÇAMENTO
                </button>
                <button onclick="mudarAbaAdmin('abaCadastros')" id="tabCadastros" class="py-3 px-4 font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                    📋 CASAIS CADASTRADOS
                </button>
                <button onclick="mudarAbaAdmin('abaLogins')" id="tabLogins" class="py-3 px-4 font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                    🔑 LOGS DE ACESSO
                </button>
            </div>

            <!-- CONTEÚDO DA ABA 1: SOLICITAÇÕES DE ORÇAMENTO -->
            <div id="abaOrcamentos" class="p-6 overflow-x-auto">
                <table class="w-full text-left text-xs sm:text-sm">
                    <thead>
                        <tr class="border-b border-stone-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 font-brand uppercase">
                            <th class="pb-3">Data</th>
                            <th class="pb-3">Casal / Contato</th>
                            <th class="pb-3">WhatsApp</th>
                            <th class="pb-3">Serviço</th>
                            <th class="pb-3">Mensagem</th>
                            <th class="pb-3">Status</th>
                            <th class="pb-3 text-right">Ação</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaOrcamentos" class="divide-y divide-stone-200 dark:divide-gray-700">
                        <!-- Preenchido dinamicamente pelo JS -->
                    </tbody>
                </table>
            </div>

            <!-- CONTEÚDO DA ABA 2: CASAIS CADASTRADOS -->
            <div id="abaCadastros" class="p-6 overflow-x-auto hidden">
                <table class="w-full text-left text-xs sm:text-sm">
                    <thead>
                        <tr class="border-b border-stone-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 font-brand uppercase">
                            <th class="pb-3">Data Cadastro</th>
                            <th class="pb-3">Cônjuge 1</th>
                            <th class="pb-3">Cônjuge 2</th>
                            <th class="pb-3">E-mail</th>
                            <th class="pb-3">WhatsApp</th>
                            <th class="pb-3">Data Casamento</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaCadastros" class="divide-y divide-stone-200 dark:divide-gray-700">
                        <!-- Preenchido dinamicamente pelo JS -->
                    </tbody>
                </table>
            </div>

            <!-- CONTEÚDO DA ABA 3: LOGS DE ACESSO -->
            <div id="abaLogins" class="p-6 overflow-x-auto hidden">
                <table class="w-full text-left text-xs sm:text-sm">
                    <thead>
                        <tr class="border-b border-stone-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 font-brand uppercase">
                            <th class="pb-3">Data / Hora</th>
                            <th class="pb-3">Usuário / E-mail</th>
                            <th class="pb-3">Tipo de Conta</th>
                            <th class="pb-3">Status do Login</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaLogins" class="divide-y divide-stone-200 dark:divide-gray-700">
                        <!-- Preenchido dinamicamente pelo JS -->
                    </tbody>
                </table>
            </div>

        </div>
    </div>


    <!-- ========================================== -->
    <!-- JAVASCRIPT DE INTERATIVIDADE E GESTÃO -->
    <!-- ========================================== -->
    <script>
        // 1. BANCO DE DADOS EM MEMÓRIA (MOCK DATA COM DADOS INICIAIS)
        let dbOrcamentos = [
            { id: 1, data: '09/09/2026 14:30', nome: 'Mariana e Lucas', email: 'mariana@email.com', telefone: '(11) 98888-1122', servico: 'Cerimônia Civil', mensagem: 'Gostaríamos de saber sobre disponibilidade para Outubro.', status: 'Pendente' },
            { id: 2, data: '08/09/2026 10:15', nome: 'Beatriz e Gabriel', email: 'beatriz@email.com', telefone: '(21) 97777-3344', servico: 'Pacote Completo', mensagem: 'Casamento para 150 convidados em sítio.', status: 'Atendido' }
        ];

        let dbCadastros = [
            { id: 1, dataCad: '09/09/2026', c1: 'Ana Silva', c2: 'Pedro Santos', email: 'ana.pedro@email.com', telefone: '(11) 99999-5555', dataCasamento: '2027-05-15' },
            { id: 2, dataCad: '07/09/2026', c1: 'Carla Dias', c2: 'Roberto Lima', email: 'carla.roberto@email.com', telefone: '(31) 98888-4444', dataCasamento: '2026-12-20' }
        ];

        let dbLogins = [
            { id: 1, dataHora: '09/09/2026 16:00', email: 'ana.pedro@email.com', tipo: 'Cliente (Casal)', status: 'Sucesso' },
            { id: 2, dataHora: '09/09/2026 09:12', email: 'admin@enlace.com', tipo: 'Administrador', status: 'Sucesso' }
        ];

        // 2. FUNÇÕES DE MODO DARK/LIGHT
        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains('dark');
            const icon = document.getElementById('themeIcon');
            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
        }

        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeIcon();
        }

        // 3. CONTROLE DE MODAIS
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.body.classList.add('modal-active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.body.classList.remove('modal-active');
        }

        function trocarModal(modalAtual, modalDestino) {
            closeModal(modalAtual);
            openModal(modalDestino);
        }

        // 4. SUBMISSÃO DE FORMULÁRIOS PÚBLICOS (ALIMENTAM O PAINEL ADMIN)
        function finalizarCadastro(event) {
            event.preventDefault();
            const c1 = document.getElementById('cadConjuge1').value;
            const c2 = document.getElementById('cadConjuge2').value;
            const email = document.getElementById('cadEmail').value;
            const telefone = document.getElementById('cadTelefone').value;
            const dataCasamento = document.getElementById('cadData').value;

            // Salva no banco dinâmico
            dbCadastros.unshift({
                id: Date.now(),
                dataCad: new Date().toLocaleDateString('pt-BR'),
                c1, c2, email, telefone, dataCasamento
            });

            // Registra Log
            dbLogins.unshift({
                id: Date.now(),
                dataHora: new Date().toLocaleString('pt-BR'),
                email: email,
                tipo: 'Novo Cadastrado',
                status: 'Sucesso'
            });

            atualizarPainelAdmin();
            document.getElementById('loginEmail').value = email;
            document.getElementById('mensagemSucessoCadastro').classList.remove('hidden');
            trocarModal('modalCadastro', 'modalLogin');
        }

        function fazerLogin(event) {
            event.preventDefault();
            const email = document.getElementById('loginEmail').value;

            dbLogins.unshift({
                id: Date.now(),
                dataHora: new Date().toLocaleString('pt-BR'),
                email: email,
                tipo: 'Cliente (Casal)',
                status: 'Sucesso'
            });

            atualizarPainelAdmin();
            alert('Login efetuado com sucesso!');
            closeModal('modalLogin');
        }

        function enviarOrcamento(event) {
            event.preventDefault();
            const nome = document.getElementById('orcNome').value;
            const email = document.getElementById('orcEmail').value;
            const telefone = document.getElementById('orcTelefone').value;
            const servico = document.getElementById('orcServico').value;
            const mensagem = document.getElementById('orcMensagem').value;

            dbOrcamentos.unshift({
                id: Date.now(),
                data: new Date().toLocaleString('pt-BR'),
                nome, email, telefone, servico, mensagem,
                status: 'Pendente'
            });

            atualizarPainelAdmin();
            alert('Sua solicitação de orçamento foi enviada com sucesso! Entraremos em contato em breve.');
            closeModal('modalOrcamento');
        }

        // 5. AUTENTICAÇÃO DO ADMINISTRADOR
        function fazerLoginAdmin(event) {
            event.preventDefault();
            const email = document.getElementById('adminEmail').value;
            const senha = document.getElementById('adminSenha').value;

            if (email === 'admin@enlace.com' && senha === 'admin123') {
                document.getElementById('erroAdmin').classList.add('hidden');
                closeModal('modalAdminLogin');
                
                // Registra Log de acesso Admin
                dbLogins.unshift({
                    id: Date.now(),
                    dataHora: new Date().toLocaleString('pt-BR'),
                    email: email,
                    tipo: 'Administrador',
                    status: 'Sucesso'
                });

                atualizarPainelAdmin();
                document.getElementById('adminDashboard').classList.remove('hidden');
                document.body.classList.add('modal-active');
            } else {
                document.getElementById('erroAdmin').classList.remove('hidden');
            }
        }

        function sairAdmin() {
            document.getElementById('adminDashboard').classList.add('hidden');
            document.body.classList.remove('modal-active');
        }

        // 6. RENDERIZAÇÃO DO PAINEL ADMINISTRATIVO
        function atualizarPainelAdmin() {
            // Atualiza KPIs
            document.getElementById('statCadastros').textContent = dbCadastros.length;
            document.getElementById('statOrcamentos').textContent = dbOrcamentos.length;
            document.getElementById('statLogins').textContent = dbLogins.length;

            // Renderiza Orçamentos
            const tbOrc = document.getElementById('tabelaOrcamentos');
            tbOrc.innerHTML = dbOrcamentos.map(o => `
                <tr class="hover:bg-stone-50 dark:hover:bg-gray-750">
                    <td class="py-3 text-stone-500">${o.data}</td>
                    <td class="py-3 font-bold">${o.nome}<br/><span class="text-xs font-normal text-stone-400">${o.email}</span></td>
                    <td class="py-3 font-mono">${o.telefone}</td>
                    <td class="py-3"><span class="bg-champagne/20 text-champagne-hover dark:text-champagne-light px-2 py-1 rounded text-xs font-bold">${o.servico}</span></td>
                    <td class="py-3 max-w-xs truncate" title="${o.mensagem}">${o.mensagem || '-'}</td>
                    <td class="py-3">
                        <span class="px-2 py-1 rounded text-xs font-bold ${o.status === 'Pendente' ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}">
                            ${o.status}
                        </span>
                    </td>
                    <td class="py-3 text-right">
                        <button onclick="alternarStatusOrcamento(${o.id})" class="text-xs bg-stone-200 dark:bg-gray-700 hover:bg-champagne hover:text-white px-2 py-1 rounded transition mr-1">
                            ${o.status === 'Pendente' ? 'Concluir' : 'Reabrir'}
                        </button>
                        <button onclick="excluirOrcamento(${o.id})" class="text-xs bg-red-100 text-red-600 hover:bg-red-600 hover:text-white px-2 py-1 rounded transition">
                            Excluir
                        </button>
                    </td>
                </tr>
            `).join('') || '<tr><td colspan="7" class="py-4 text-center text-stone-400">Nenhuma solicitação recebida.</td></tr>';

            // Renderiza Cadastros
            const tbCad = document.getElementById('tabelaCadastros');
            tbCad.innerHTML = dbCadastros.map(c => `
                <tr class="hover:bg-stone-50 dark:hover:bg-gray-750">
                    <td class="py-3 text-stone-500">${c.dataCad}</td>
                    <td class="py-3 font-bold text-dustyrose dark:text-dustyrose-light">${c.c1}</td>
                    <td class="py-3 font-bold text-dustyrose dark:text-dustyrose-light">${c.c2}</td>
                    <td class="py-3">${c.email}</td>
                    <td class="py-3 font-mono">${c.telefone}</td>
                    <td class="py-3 font-bold">${c.dataCasamento || '-'}</td>
                </tr>
            `).join('') || '<tr><td colspan="6" class="py-4 text-center text-stone-400">Nenhum casal cadastrado ainda.</td></tr>';

            // Renderiza Logins
            const tbLog = document.getElementById('tabelaLogins');
            tbLog.innerHTML = dbLogins.map(l => `
                <tr class="hover:bg-stone-50 dark:hover:bg-gray-750">
                    <td class="py-3 text-stone-500 font-mono">${l.dataHora}</td>
                    <td class="py-3 font-bold">${l.email}</td>
                    <td class="py-3"><span class="bg-eucalyptus/20 text-eucalyptus px-2 py-1 rounded text-xs font-bold">${l.tipo}</span></td>
                    <td class="py-3"><span class="text-green-600 font-bold">✓ ${l.status}</span></td>
                </tr>
            `).join('') || '<tr><td colspan="4" class="py-4 text-center text-stone-400">Nenhum log registrado.</td></tr>';
        }

        // 7. AÇÕES NO PAINEL ADMIN
        function alternarStatusOrcamento(id) {
            const item = dbOrcamentos.find(o => o.id === id);
            if (item) {
                item.status = item.status === 'Pendente' ? 'Atendido' : 'Pendente';
                atualizarPainelAdmin();
            }
        }

        function excluirOrcamento(id) {
            if (confirm('Tem certeza que deseja excluir esta solicitação?')) {
                dbOrcamentos = dbOrcamentos.filter(o => o.id !== id);
                atualizarPainelAdmin();
            }
        }

        function mudarAbaAdmin(idAba) {
            ['abaOrcamentos', 'abaCadastros', 'abaLogins'].forEach(aba => {
                document.getElementById(aba).classList.add('hidden');
            });
            ['tabOrcamentos', 'tabCadastros', 'tabLogins'].forEach(tab => {
                document.getElementById(tab).className = "py-3 px-4 font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300";
            });

            document.getElementById(idAba).classList.remove('hidden');

            if (idAba === 'abaOrcamentos') {
                document.getElementById('tabOrcamentos').className = "py-3 px-4 font-bold border-b-2 border-champagne text-champagne";
            } else if (idAba === 'abaCadastros') {
                document.getElementById('tabCadastros').className = "py-3 px-4 font-bold border-b-2 border-dustyrose text-dustyrose";
            } else if (idAba === 'abaLogins') {
                document.getElementById('tabLogins').className = "py-3 px-4 font-bold border-b-2 border-eucalyptus text-eucalyptus";
            }
        }

        // Inicialização ao carregar a página
        document.addEventListener('DOMContentLoaded', () => {
            updateThemeIcon();
            atualizarPainelAdmin();
        });
    </script>
</body>
</html>